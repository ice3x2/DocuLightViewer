{
  "version": "wave2-client-profile-oracles.v1",
  "oracles": [
    {
      "intentId": "save_only_generated_markdown",
      "clientProfile": "codex",
      "prompt": "Save this generated Markdown note into the DocuLight knowledge store without opening or focusing a viewer window.",
      "expectedToolName": "save_document",
      "rejectedToolNames": ["open_markdown", "update_markdown", "rebuild_index", "clear_index", "retry_indexing", "cancel_indexing"],
      "expectedMinimalArguments": {
        "content": "# Title\n\nBody",
        "title": "Title",
        "category": "notes",
        "documentTags": ["agent"]
      },
      "expectedEnvelopeShape": {
        "requiredKeys": ["ok", "documentId", "path", "indexing", "warnings"],
        "structuredContent": false,
        "opensViewer": false
      },
      "expectedErrorShape": {
        "requiredKeys": ["ok", "error", "code", "warnings"],
        "redacted": true
      },
      "expectedDiagnostics": ["queued_background_indexing", "duplicate_source_identity_checked"],
      "expectedRedactions": ["absolute_path", "git_remote", "api_key", "source_url"],
      "outputCaps": {
        "resultsLength": 20,
        "snippetTextChars": 240,
        "headingPathLength": 4,
        "headingPathItemChars": 80,
        "warningsLength": 3,
        "diagnosticsWarningsLength": 6,
        "diagnosticStatusItems": 8,
        "traceItems": 4,
        "scoreDetailFields": 7,
        "defaultSerializedBytes": 32768,
        "diagnosticSerializedBytes": 65536
      }
    },
